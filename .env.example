# Create a Supabase project and copy these values from its API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
QURA_HASH_SECRET=

# Server-to-server student eligibility sync. Use the same random 32+ byte key in the student system.
QURA_STUDENT_SYNC_KEY=

# Server-only Resend email delivery for election verification codes.
RESEND_API_KEY=
QURA_EMAIL_FROM=
RESEND_TEST_MODE=false

# Optional. Required to enable Turnstile on polls with bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
